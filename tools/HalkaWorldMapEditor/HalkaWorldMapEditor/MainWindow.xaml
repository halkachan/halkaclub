<Window x:Class="HalkaWorldMapEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF" Title="HALKA WORLD MAP EDITOR v0.4" Icon="Assets/map-editor.ico" Width="1450" Height="880" MinWidth="1050" MinHeight="640" Background="#16191E" Foreground="#E4E8EC" FontFamily="Yu Gothic UI" FontSize="13" Loaded="WindowLoaded" Activated="WindowActivated" Closing="WindowClosing" KeyDown="WindowKeyDown">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#333B46"/><Setter Property="Foreground" Value="#F1F3F6"/><Setter Property="BorderBrush" Value="#586170"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="3"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#242A33"/><Setter Property="Foreground" Value="#F1F3F6"/><Setter Property="BorderBrush" Value="#586170"/><Setter Property="Padding" Value="5"/></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#111111"/><Setter Property="Margin" Value="3"/><Setter Property="MinWidth" Value="190"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DDE2E8"/><Setter Property="Margin" Value="6,4"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="#242A33"/><Setter Property="Foreground" Value="#EDF0F3"/><Setter Property="BorderBrush" Value="#586170"/></Style>
</Window.Resources>
<DockPanel>
<Menu DockPanel.Dock="Top" Background="#252C35" Foreground="#F1F3F6"><MenuItem Header="ファイル"><MenuItem Header="Unity Projectを開く..." Click="ChooseProject"/><MenuItem Header="再読み込み" Click="ReloadMap"/><MenuItem Header="保存   Ctrl+S" Click="SaveMap"/><Separator/><MenuItem Header="終了" Click="ExitApp"/></MenuItem><MenuItem Header="編集"><MenuItem Header="元に戻す   Ctrl+Z" Click="UndoClick"/><MenuItem Header="やり直す   Ctrl+Y" Click="RedoClick"/><MenuItem Header="選択Objectを削除   Delete" Click="DeleteClick"/></MenuItem><MenuItem Header="表示"><MenuItem Header="Map全体を表示   F" Click="FitClick"/><MenuItem Header="検証" Click="ValidateClick"/></MenuItem><MenuItem Header="ヘルプ"><MenuItem Header="このツールについて" Click="AboutClick"/></MenuItem></Menu>
<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,3" Background="#20262F"><TextBlock Text="Map" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="MapPicker" SelectionChanged="MapPickerChanged" Width="205"/><Button Content="Project..." Click="ChooseProject"/><Button Content="保存" Click="SaveMap"/><Button Content="戻す" Click="UndoClick"/><Button Content="やり直す" Click="RedoClick"/><Button Content="選択 [1]" Click="SelectToolClick"/><Button Content="配置 [2]" Click="PaintToolClick"/><Button Content="消去 [3]" Click="EraseToolClick"/><Button Content="全体表示 [F]" Click="FitClick"/></StackPanel>
<Border DockPanel.Dock="Bottom" Background="#20262F" BorderBrush="#4A5360" BorderThickness="0,1,0,0"><DockPanel Margin="9,5"><TextBlock x:Name="DirtyText" DockPanel.Dock="Right" Foreground="#FFCB75" HorizontalAlignment="Right"/><TextBlock x:Name="ActivePaletteText" DockPanel.Dock="Left" Text="選択" Margin="0,0,20,0" Foreground="#CFE2B9"/><TextBlock x:Name="StatusText" Text="Projectを開いてください。"/></DockPanel></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#20262F" Margin="4" Padding="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PALETTE" FontWeight="Bold" Margin="2,2,2,9"/><TextBox x:Name="PaletteSearch" DockPanel.Dock="Top" Margin="0,0,0,6" ToolTip="Paletteを検索" TextChanged="PaletteSearchChanged"/><TextBlock DockPanel.Dock="Bottom" Text="左クリック: 選択/配置  右クリック: 消去&#10;ドラッグ: 草/土を連続配置&#10;中ボタンまたはSpace+ドラッグ: Pan&#10;ホイール: Zoom" TextWrapping="Wrap" Foreground="#AAB4C2" Margin="3,12,2,3"/><ListBox x:Name="PaletteList" SelectionChanged="PaletteChanged"><ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#AAB4C2" Margin="4,8,0,3"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}"><Image Source="{Binding PreviewIcon}" Width="24" Height="24" Margin="0,2,8,2" RenderOptions.BitmapScalingMode="NearestNeighbor"/><StackPanel><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding AssetStatus}" Foreground="#FFBE75" FontSize="10"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Grid Grid.Column="1" Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="132"/></Grid.RowDefinitions><WrapPanel Background="#20262F" Margin="0,0,0,3"><CheckBox x:Name="GridCheck" Content="Grid" IsChecked="True" Checked="OverlayChanged" Unchecked="OverlayChanged"/><CheckBox x:Name="GrassCheck" Content="Grass" IsChecked="True" Checked="OverlayChanged" Unchecked="OverlayChanged"/><CheckBox x:Name="CollisionCheck" Content="Collision" Checked="OverlayChanged" Unchecked="OverlayChanged"/><CheckBox x:Name="CoordCheck" Content="座標" Checked="OverlayChanged" Unchecked="OverlayChanged"/><CheckBox x:Name="MarkerCheck" Content="Markers" IsChecked="True" Checked="OverlayChanged" Unchecked="OverlayChanged"/><CheckBox x:Name="ActionPointCheck" Content="Action Points" IsChecked="True" Checked="OverlayChanged" Unchecked="OverlayChanged"/></WrapPanel><Border Grid.Row="1" Background="#738353" ClipToBounds="True"><skia:SKElement x:Name="MapCanvas" PaintSurface="MapCanvasPaint" MouseDown="CanvasMouseDown" MouseMove="CanvasMouseMove" MouseUp="CanvasMouseUp" MouseWheel="CanvasMouseWheel" MouseLeave="CanvasMouseLeave"/></Border><DockPanel Grid.Row="2" Background="#20262F" Margin="0,4,0,0"><TextBlock Text="VALIDATION" DockPanel.Dock="Top" FontWeight="Bold" Margin="8,5"/><ListBox x:Name="ValidationList" MouseDoubleClick="ValidationDoubleClick"/></DockPanel></Grid>
<Border Grid.Column="2" Background="#20262F" Margin="4" Padding="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="INSPECTOR" FontWeight="Bold" Margin="0,2,0,13"/><TextBlock x:Name="SelectedKind" Text="セルを選択してください" TextWrapping="Wrap" Margin="0,0,0,9"/><TextBlock Text="Instance ID" Foreground="#AEB8C3"/><TextBox x:Name="InstanceText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="Root Cell X / Y" Foreground="#AEB8C3"/><StackPanel Orientation="Horizontal" Margin="0,4,0,4"><TextBox x:Name="RootX" Width="75"/><TextBox x:Name="RootY" Width="75" Margin="7,0,0,0"/></StackPanel><Button Content="座標へ移動" Click="MoveObjectClick"/><Button Content="Objectを削除" Click="DeleteClick"/><Expander Header="Action Points" IsExpanded="True" Margin="0,12,0,6"><TextBlock x:Name="ActionPointInfo" TextWrapping="Wrap" Foreground="#CFE2B9"/></Expander><Separator Margin="0,14"/><TextBlock Text="Map情報" FontWeight="Bold" Margin="0,0,0,7"/><TextBlock x:Name="MapInfo" TextWrapping="Wrap" Foreground="#C6D0D9"/></StackPanel></ScrollViewer></Border></Grid></DockPanel></Window>
