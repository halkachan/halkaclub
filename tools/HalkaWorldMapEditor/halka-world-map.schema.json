{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halkaclub.com/schemas/halka-world-map-v3.json",
  "title": "HALKA WORLD Map Authoring v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "mapId", "displayName", "mapType", "baseSurfaceDefinitionId", "grassMode", "backdropColor", "bounds", "surfaces", "objects", "markers", "entitySpawns"],
  "properties": {
    "format": { "const": "halka-world-map" },
    "formatVersion": { "const": 3 },
    "mapId": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "mapType": { "enum": ["outdoor", "interior"] },
    "baseSurfaceDefinitionId": { "type": "string", "minLength": 1 },
    "grassMode": { "enum": ["auto", "none"] },
    "backdropColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["minX", "maxX", "minY", "maxY"],
      "properties": { "minX": { "type": "integer" }, "maxX": { "type": "integer" }, "minY": { "type": "integer" }, "maxY": { "type": "integer" } }
    },
    "surfaces": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["definitionId", "cell"],
        "properties": { "definitionId": { "type": "string", "minLength": 1 }, "cell": { "$ref": "#/$defs/cell" } }
      }
    },
    "objects": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["instanceId", "definitionId", "rootCell"],
        "properties": {
          "instanceId": { "type": "string", "minLength": 1 },
          "definitionId": { "type": "string", "minLength": 1 },
          "rootCell": { "$ref": "#/$defs/cell" },
          "signText": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "markers": { "type": "array", "items": { "$ref": "#/$defs/marker" } },
    "entitySpawns": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["instanceId", "definitionId", "cell", "facing"],
      "properties": {
        "instanceId": { "type": "string", "minLength": 1 },
        "definitionId": { "type": "string", "minLength": 1 },
        "cell": { "$ref": "#/$defs/cell" },
        "facing": { "enum": ["up", "down", "left", "right"] }
      }
    } }
  },
  "$defs": {
    "cell": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } } },
    "marker": { "type": "object", "additionalProperties": false, "required": ["id", "cell"], "properties": { "id": { "type": "string", "minLength": 1 }, "cell": { "$ref": "#/$defs/cell" } } }
  }
}
