<Window x:Class="HalkaSiteEditor.VideoPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HalkaSiteEditor"
        Title="最近の動画から選ぶ" Width="860" Height="660" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#16191E" Foreground="#E4E8EC" FontFamily="Yu Gothic UI" FontSize="13"
        Loaded="WindowLoaded">

  <Window.Resources>
    <local:TextToVisibilityConverter x:Key="TextToVisibility"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#333B46"/>
      <Setter Property="Foreground" Value="#F1F3F6"/>
      <Setter Property="BorderBrush" Value="#586170"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#242A33"/>
      <Setter Property="Foreground" Value="#F1F3F6"/>
      <Setter Property="BorderBrush" Value="#586170"/>
      <Setter Property="CaretBrush" Value="#F1F3F6"/>
      <Setter Property="Padding" Value="5,4"/>
    </Style>

    <DataTemplate x:Key="VideoTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,5" Padding="10,8">
        <DockPanel>
          <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected, Mode=TwoWay}"
                    IsEnabled="{Binding CanAdd}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding PublishedAt}" Foreground="#9AA6B4"
                     VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>
          <StackPanel>
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Note}" Foreground="#FFCB75" FontSize="11" Margin="0,2,0,0"
                       Visibility="{Binding Note, Converter={StaticResource TextToVisibility}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#AEB8C3" Margin="0,0,0,10"
               Text="YouTubeの新着（最新15本）です。まだ作品一覧に入っていないものだけ選べます。選んで足したあと、タイトルは好きに直せます。"/>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,10,0">
        <TextBlock Text="足し先の分類" Foreground="#9AA6B4" FontSize="11" Margin="0,0,0,3"/>
        <ComboBox x:Name="CategoryPicker"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,8,0">
        <TextBlock Text="チャンネルID" Foreground="#9AA6B4" FontSize="11" Margin="0,0,0,3"/>
        <TextBox x:Name="ChannelBox"/>
      </StackPanel>
      <Button Grid.Column="2" Content="取り直す" Click="ReloadClick" VerticalAlignment="Bottom"/>
    </Grid>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#9AA6B4" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取りやめ" Click="CancelClick" IsCancel="True"/>
        <Button x:Name="AddButton" Content="選んだ動画を足す" Click="AddClick" FontWeight="Bold"
                Padding="20,6" IsEnabled="False"/>
      </StackPanel>
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="VideoItems" ItemTemplate="{StaticResource VideoTemplate}"/>
    </ScrollViewer>
  </DockPanel>
</Window>
