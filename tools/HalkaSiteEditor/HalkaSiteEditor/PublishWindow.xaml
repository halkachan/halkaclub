<Window x:Class="HalkaSiteEditor.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="サイトを公開する" Width="760" Height="620" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#16191E" Foreground="#E4E8EC" FontFamily="Yu Gothic UI" FontSize="13">

  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#333B46"/>
      <Setter Property="Foreground" Value="#F1F3F6"/>
      <Setter Property="BorderBrush" Value="#586170"/>
      <Setter Property="Padding" Value="18,7"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#242A33"/>
      <Setter Property="Foreground" Value="#F1F3F6"/>
      <Setter Property="BorderBrush" Value="#586170"/>
      <Setter Property="CaretBrush" Value="#F1F3F6"/>
      <Setter Property="Padding" Value="6,5"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">

    <!-- 念押し -->
    <Border DockPanel.Dock="Top" Background="#3A2F12" BorderBrush="#FFCB75" BorderThickness="2"
            Padding="14,11" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="押すと halkaclub.com が本当に変わります。" FontSize="15" FontWeight="Bold"
                   Foreground="#FFCB75"/>
        <TextBlock x:Name="TargetText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#E4E8EC"/>
      </StackPanel>
    </Border>

    <!-- 操作 -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <TextBlock x:Name="BusyText" VerticalAlignment="Center" Foreground="#9AA6B4"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取りやめ" Click="CancelClick" IsCancel="True"/>
        <Button x:Name="PublishButton" Content="公開する" Click="PublishClick" FontWeight="Bold"
                Padding="26,7" Background="#4A6B3A"/>
      </StackPanel>
    </DockPanel>

    <!-- メッセージ -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <TextBlock Text="記録に残す説明（あとで見返すときの手がかりです）" Foreground="#AEB8C3" Margin="0,0,0,5"/>
      <TextBox x:Name="MessageBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"/>
    </StackPanel>

    <!-- 公開されるもの -->
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="公開されるファイル" Foreground="#AEB8C3" Margin="0,0,0,5"/>
      <TextBlock DockPanel.Dock="Bottom" x:Name="ScopeText" TextWrapping="Wrap" Foreground="#8C97A6"
                 FontSize="11" Margin="0,7,0,0"
                 Text="このツールが扱うファイルだけを公開します。unity-project など、作業中のほかの変更は手元に残ります。"/>
      <ListView x:Name="FileList" Background="#242A33" Foreground="#EDF0F3" BorderBrush="#2F3845">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="状態" Width="110" DisplayMemberBinding="{Binding Status}"/>
            <GridViewColumn Header="ファイル" Width="560" DisplayMemberBinding="{Binding Path}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </DockPanel>
  </DockPanel>
</Window>
