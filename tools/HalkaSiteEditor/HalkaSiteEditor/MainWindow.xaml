<Window x:Class="HalkaSiteEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HalkaSiteEditor"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HALKA SITE EDITOR v1.7" Icon="Assets/site-editor.ico"
        Width="1660" Height="900" MinWidth="1000" MinHeight="640"
        Background="#16191E" Foreground="#E4E8EC" FontFamily="Yu Gothic UI" FontSize="13"
        Loaded="WindowLoaded" Closing="WindowClosing">

  <Window.Resources>
    <local:HexToBrushConverter x:Key="HexToBrush"/>
    <local:TextToVisibilityConverter x:Key="TextToVisibility"/>
    <local:ChangedToBrushConverter x:Key="ChangedToBrush"/>
    <local:KindMatchConverter x:Key="KindMatch"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#333B46"/>
      <Setter Property="Foreground" Value="#F1F3F6"/>
      <Setter Property="BorderBrush" Value="#586170"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#242A33"/>
      <Setter Property="Foreground" Value="#F1F3F6"/>
      <Setter Property="BorderBrush" Value="#586170"/>
      <Setter Property="CaretBrush" Value="#F1F3F6"/>
      <Setter Property="Padding" Value="5,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9AA6B4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF8A8A"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="Visibility" Value="{Binding Error, Converter={StaticResource TextToVisibility}}"/>
      <Setter Property="Text" Value="{Binding Error}"/>
    </Style>

    <!-- 依頼ページ：日本語と英語がとなり合った1行 -->
    <DataTemplate x:Key="PairTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,8" Padding="12,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                     TextWrapping="Wrap" Margin="0,0,12,0" FontSize="14"/>

          <StackPanel Grid.Column="1" Margin="0,0,10,0">
            <TextBlock Text="日本語" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding Ja.Value, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="2"
                     BorderBrush="{Binding Ja.Changed, Converter={StaticResource ChangedToBrush}}"/>
            <TextBlock DataContext="{Binding Ja}" Style="{StaticResource ErrorText}"/>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="英語" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding En.Value, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="2"
                     BorderBrush="{Binding En.Changed, Converter={StaticResource ChangedToBrush}}"/>
            <TextBlock DataContext="{Binding En}" Style="{StaticResource ErrorText}"/>
          </StackPanel>

          <Button Grid.Column="3" Content="英語を合わせる" VerticalAlignment="Bottom"
                  Click="SyncEnglishClick" Tag="{Binding}"
                  IsEnabled="{Binding CanSyncEnglish, Mode=OneWay}"
                  ToolTip="日本語側の数字から「from 〇〇 JPY」を作ります。"/>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- 名前のついた入力欄をいくつか並べた1行（リンク・くらぶ・うたまぜ用） -->
    <DataTemplate x:Key="RowTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,8" Padding="12,10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="150" VerticalAlignment="Center"
                     TextWrapping="Wrap" Margin="0,0,12,0" FontSize="14"/>
          <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding Field.Value, UpdateSourceTrigger=PropertyChanged}"
                           BorderThickness="2"
                           BorderBrush="{Binding Field.Changed, Converter={StaticResource ChangedToBrush}}"
                           Visibility="{Binding Field.Kind, Converter={StaticResource KindMatch},
                                                ConverterParameter=!Boolean}"/>
                  <CheckBox IsChecked="{Binding Field.IsOn, Mode=TwoWay}" Content="はい" Foreground="#DDE2E8"
                            Margin="0,4,0,0"
                            Visibility="{Binding Field.Kind, Converter={StaticResource KindMatch},
                                                 ConverterParameter=Boolean}"/>
                  <TextBlock DataContext="{Binding Field}" Style="{StaticResource ErrorText}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- 追加プラン（名前と金額を日英で） -->
    <DataTemplate x:Key="OptionTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,8" Padding="12,10">
        <StackPanel>
          <TextBlock Text="{Binding Label}" FontSize="14" Margin="0,0,0,7"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Text="名前（日本語）" Style="{StaticResource Caption}"/>
              <TextBox Text="{Binding Name.Ja.Value, UpdateSourceTrigger=PropertyChanged}" BorderThickness="2"
                       BorderBrush="{Binding Name.Ja.Changed, Converter={StaticResource ChangedToBrush}}"/>
              <TextBlock DataContext="{Binding Name.Ja}" Style="{StaticResource ErrorText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
              <TextBlock Text="名前（英語）" Style="{StaticResource Caption}"/>
              <TextBox Text="{Binding Name.En.Value, UpdateSourceTrigger=PropertyChanged}" BorderThickness="2"
                       BorderBrush="{Binding Name.En.Changed, Converter={StaticResource ChangedToBrush}}"/>
              <TextBlock DataContext="{Binding Name.En}" Style="{StaticResource ErrorText}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
              <TextBlock Text="金額（日本語）" Style="{StaticResource Caption}"/>
              <TextBox Text="{Binding Price.Ja.Value, UpdateSourceTrigger=PropertyChanged}" BorderThickness="2"
                       BorderBrush="{Binding Price.Ja.Changed, Converter={StaticResource ChangedToBrush}}"/>
              <TextBlock DataContext="{Binding Price.Ja}" Style="{StaticResource ErrorText}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,8,0">
              <TextBlock Text="金額（英語）" Style="{StaticResource Caption}"/>
              <TextBox Text="{Binding Price.En.Value, UpdateSourceTrigger=PropertyChanged}" BorderThickness="2"
                       BorderBrush="{Binding Price.En.Changed, Converter={StaticResource ChangedToBrush}}"/>
              <TextBlock DataContext="{Binding Price.En}" Style="{StaticResource ErrorText}"/>
            </StackPanel>
            <Button Grid.Column="4" Content="英語を合わせる" VerticalAlignment="Bottom"
                    Click="SyncOptionEnglishClick" Tag="{Binding}"
                    IsEnabled="{Binding CanSyncEnglish, Mode=OneWay}"/>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 文章のかたまり1つ -->
    <DataTemplate x:Key="TextBlockTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,8" Padding="12,10">
        <StackPanel>
          <DockPanel Margin="0,0,0,5">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="14"/>
            <TextBlock Text="{Binding Hint}" Foreground="#8C97A6" FontSize="11" Margin="12,2,0,0"/>
          </DockPanel>
          <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="260"
                   VerticalScrollBarVisibility="Auto" BorderThickness="2"
                   BorderBrush="{Binding Changed, Converter={StaticResource ChangedToBrush}}"
                   FontFamily="Yu Gothic UI"/>
          <TextBlock Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="{Binding Error}"
                     Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- リリースの切り替え1つ -->
    <DataTemplate x:Key="ReleaseTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,7" Padding="12,9">
        <DockPanel>
          <CheckBox DockPanel.Dock="Left" IsChecked="{Binding MakeLive, Mode=TwoWay}" Width="140"
                    Content="公開の形にする" Foreground="#DDE2E8" VerticalAlignment="Center"/>
          <Border DockPanel.Dock="Right" Width="64" Height="26" CornerRadius="13" Margin="10,0,0,0"
                  Background="#242A33" BorderBrush="#586170" BorderThickness="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding StateText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12"/>
          </Border>
          <StackPanel>
            <TextBlock Text="{Binding Label}" FontSize="14"/>
            <TextBlock Text="{Binding Note}" Foreground="#8C97A6" FontSize="11" TextWrapping="Wrap"
                       Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Missing}" Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap"
                       Margin="0,3,0,0"
                       Visibility="{Binding Missing, Converter={StaticResource TextToVisibility}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- うれしいこと 1件 -->
    <DataTemplate x:Key="NewsTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,6" Padding="10,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Top">
            <Button Content="↑" Click="NewsUpClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="↓" Click="NewsDownClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="✕" Click="NewsDeleteClick" Tag="{Binding}" Width="30" Padding="0,3"
                    ToolTip="このお知らせを消します"/>
          </StackPanel>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="日付" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="「2/21投稿」「4/25〜4/26開催」のように、自由に書けます。"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="見出し" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="説明（いらなければ空のまま）" Style="{StaticResource Caption}" Margin="0,6,0,3"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="受賞・参加など（1行＝1つ。いらなければ空のまま）" Style="{StaticResource Caption}"
                       Margin="0,6,0,3"/>
            <TextBox Text="{Binding Achievements, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="120"
                     VerticalScrollBarVisibility="Auto"/>
            <TextBlock Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- 作品一覧の1件 -->
    <DataTemplate x:Key="WorkTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,6" Padding="10,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
            <Button Content="↑" Click="WorkUpClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="↓" Click="WorkDownClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="✕" Click="WorkDeleteClick" Tag="{Binding}" Width="30" Padding="0,3"
                    ToolTip="この作品を一覧から外します"/>
          </StackPanel>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="260"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="タイトル" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="投稿日" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding PublishedAt, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="YouTubeのURL" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding YouTubeUrl, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </Grid>
            <TextBlock Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- ゲーム集のカード1枚 -->
    <DataTemplate x:Key="GameCardTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,6" Padding="10,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Top">
            <Button Content="↑" Click="GameCardUpClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="↓" Click="GameCardDownClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="✕" Click="GameCardDeleteClick" Tag="{Binding}" Width="30" Padding="0,3"
                    ToolTip="このカードを一覧から外します（ゲームのページは残ります）"/>
          </StackPanel>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="名前" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="ゲームページの場所" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Href, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="gyugyu-rinchan/ のように、フォルダー名と / で書きます。"/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="説明（1行＝1行）" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="140"
                         VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="札（1行＝1つ）" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="140"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="「スマホ対応」「縦画面推奨」「ver 1.2」などを1行ずつ。"/>
              </StackPanel>
            </Grid>
            <TextBlock Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- 更新履歴の1件 -->
    <DataTemplate x:Key="ChangelogTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,6" Padding="10,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Top">
            <Button Content="↑" Click="ChangelogUpClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="↓" Click="ChangelogDownClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="✕" Click="ChangelogDeleteClick" Tag="{Binding}" Width="30" Padding="0,3"
                    ToolTip="この版の履歴を消します"/>
          </StackPanel>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="版" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="日付" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="2026-09-10 の形。ページには 2026.9.10 の形で出ます。"/>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <TextBlock Text="ページに出る日付" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding Display}" Foreground="#AEB8C3" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="内容（1行＝1つ。**ここ** で強調できます）" Style="{StaticResource Caption}"
                       Margin="0,6,0,3"/>
            <TextBox Text="{Binding Items, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="200"
                     VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="補足（いらなければ空のまま）" Style="{StaticResource Caption}" Margin="0,6,0,3"/>
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- リンク集のカード1枚 -->
    <DataTemplate x:Key="LinkCardTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,6" Padding="10,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Top">
            <Button Content="↑" Click="LinkUpClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="↓" Click="LinkDownClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="✕" Click="LinkDeleteClick" Tag="{Binding}" Width="30" Padding="0,3"
                    ToolTip="このリンクを一覧から外します"/>
          </StackPanel>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="印" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Mark, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="左の四角に出る1〜2文字です。"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="名前" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="説明" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="リンク先" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Href, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="http から始めるとよそのサイト（別タブで開きます）、そうでなければサイトの中です。"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="読み上げ" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Aria, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="画面を読み上げる人に伝わる言い方で（「YouTubeを開く」など）。"/>
              </StackPanel>
              <CheckBox Grid.Column="2" IsChecked="{Binding Main, Mode=TwoWay}" Content="大きく出す"
                        Foreground="#DDE2E8" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
            </Grid>
            <TextBlock Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- HALKA WORLD：更新履歴の1件 -->
    <DataTemplate x:Key="WorldEntryTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,6" Padding="10,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Top">
            <Button Content="↑" Click="WorldUpClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="↓" Click="WorldDownClick" Tag="{Binding}" Width="30" Padding="0,3"/>
            <Button Content="✕" Click="WorldDeleteClick" Tag="{Binding}" Width="30" Padding="0,3"
                    ToolTip="この版の履歴を消します"/>
          </StackPanel>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="版" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="日付" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="2026-10-07 の形です。"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="内容（1行＝1つ）" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding Items, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="160"
                         VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
            </Grid>
            <TextBlock Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- HALKA WORLD：更新履歴をまとめている箱 -->
    <DataTemplate x:Key="WorldArchiveTemplate">
      <Border Background="#1A1F26" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,10" Padding="12,10">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="箱の名前" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" MaxWidth="320"
                     HorizontalAlignment="Left" MinWidth="220"
                     ToolTip="たたんで表示される見出しです（「ver2.1 ～ ver3.0」など）。"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource WorldEntryTemplate}"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 色：色見本つきの1行 -->
    <DataTemplate x:Key="ColorTemplate">
      <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,8" Padding="12,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="14"/>
          <Border Grid.Column="1" Width="52" Height="34" Margin="0,0,12,0" CornerRadius="3"
                  BorderBrush="#586170" BorderThickness="1"
                  Background="{Binding SwatchHex, Converter={StaticResource HexToBrush}}"/>
          <StackPanel Grid.Column="2">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="2"
                     BorderBrush="{Binding Changed, Converter={StaticResource ChangedToBrush}}"/>
            <TextBlock Style="{StaticResource ErrorText}"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>

    <!-- 上：サイトのフォルダー -->
    <Border DockPanel.Dock="Top" Background="#20262F" BorderBrush="#2F3845" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,7">
        <TextBlock Text="サイトのフォルダー" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AEB8C3"/>
        <CheckBox DockPanel.Dock="Right" x:Name="PreviewToggle" Content="プレビュー" IsChecked="True"
                  Foreground="#DDE2E8" VerticalAlignment="Center" Margin="10,0,4,0"
                  Checked="PreviewToggled" Unchecked="PreviewToggled"/>
        <Button DockPanel.Dock="Right" Content="読み込み直す" Click="ReloadClick"/>
        <Button DockPanel.Dock="Right" Content="近道を作る" Click="ShortcutClick"
                ToolTip="デスクトップとスタートメニューに、このアプリの近道を作ります。"/>
        <Button DockPanel.Dock="Right" Content="フォルダーを選ぶ..." Click="ChooseFolderClick"/>
        <TextBox x:Name="RootText" IsReadOnly="True" Margin="0,0,8,0"/>
      </DockPanel>
    </Border>

    <!-- 下：状態 -->
    <Border DockPanel.Dock="Bottom" Background="#20262F" BorderBrush="#2F3845" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Margin="10,6" TextWrapping="Wrap" Text="読み込み中です。"/>
    </Border>

    <!-- 下：変更一覧 -->
    <Border DockPanel.Dock="Bottom" Background="#1A1F26" BorderBrush="#2F3845" BorderThickness="0,1,0,0"
            Height="215">
      <DockPanel Margin="10,8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="変更一覧" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock x:Name="ChangeCountText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFCB75"/>
          <Button DockPanel.Dock="Right" x:Name="PublishButton" Content="公開する" Click="PublishClick"
                  IsEnabled="False" Padding="22,6" FontWeight="Bold" Background="#4A6B3A"
                  ToolTip="保存した内容を halkaclub.com へ出します。"/>
          <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="保存する" Click="SaveClick"
                  IsEnabled="False" Padding="22,6" FontWeight="Bold"/>
          <Button DockPanel.Dock="Right" x:Name="RevertButton" Content="すべて元に戻す" Click="RevertClick"
                  IsEnabled="False"/>
          <Button DockPanel.Dock="Right" x:Name="UndoButton" Content="元に戻す" Click="UndoClick"
                  IsEnabled="False"
                  ToolTip="追加・並べ替え・削除を1手ずつ戻します（文字の打ち直しは、入力欄の中で Ctrl+Z です）。"/>
          <Button DockPanel.Dock="Left" x:Name="BackupButton" Content="保存を1つ前に戻す"
                  Click="RestoreBackupClick" IsEnabled="False" Margin="14,3,3,3"/>
          <Button DockPanel.Dock="Left" Content="サイトを開く" Click="OpenLiveSiteClick" Margin="3"
                  ToolTip="halkaclub.com をブラウザーで開きます。"/>
          <Button DockPanel.Dock="Left" Content="点検する" Click="CheckClick" Margin="3"
                  ToolTip="リンク切れ・画像の欠け・?v= の付け忘れなどを、まとめて見ます。"/>
          <TextBlock/>
        </DockPanel>
        <ListView x:Name="ChangeList" Background="#242A33" Foreground="#EDF0F3" BorderBrush="#2F3845">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="項目" Width="230" DisplayMemberBinding="{Binding Label}"/>
              <GridViewColumn Header="変更前" Width="250" DisplayMemberBinding="{Binding Before}"/>
              <GridViewColumn Header="変更後" Width="250" DisplayMemberBinding="{Binding After}"/>
              <GridViewColumn Header="ファイル" Width="230" DisplayMemberBinding="{Binding File}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </Border>

    <!-- 中央：左が編集、右がプレビュー -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="520"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="PreviewColumn" Width="860" MinWidth="0"/>
      </Grid.ColumnDefinitions>

    <TabControl Grid.Column="0" x:Name="Tabs" Background="Transparent" BorderThickness="0" Margin="6"
                SelectionChanged="TabChanged">

      <TabItem Header="依頼ページ">
        <DockPanel Margin="4,10,4,0">
          <TextBlock x:Name="CommissionNote" DockPanel.Dock="Top" Foreground="#AEB8C3"
                     TextWrapping="Wrap" Margin="2,0,2,10"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2,0,10,10">
              <ItemsControl x:Name="CommissionItems" ItemTemplate="{StaticResource PairTemplate}"/>
              <TextBlock Text="追加プラン" FontSize="15" Margin="2,10,0,7" Foreground="#FFCB75"/>
              <ItemsControl x:Name="OptionItems" ItemTemplate="{StaticResource OptionTemplate}"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="ページの文章">
        <DockPanel Margin="4,10,4,0">
          <TextBlock DockPanel.Dock="Top" Foreground="#AEB8C3" TextWrapping="Wrap" Margin="2,0,2,10"
                     Text="依頼ページとうたまぜ！のページの、説明文・見出し・箇条書き・注意書き・テンプレートです。HTMLの印は出てきません。ページごとに段落の作りが違うので、ページを選んで直します。"/>
          <DockPanel DockPanel.Dock="Top" Margin="2,0,10,10">
            <TextBlock Text="ページ" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AEB8C3"/>
            <ComboBox x:Name="TextPagePicker" MinWidth="220" HorizontalAlignment="Left"
                      SelectionChanged="TextPageChanged"/>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TextBlockItems" ItemTemplate="{StaticResource TextBlockTemplate}"
                          Margin="2,0,10,10"/>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="作品一覧">
        <DockPanel Margin="4,10,4,0">
          <TextBlock x:Name="WorksNote" DockPanel.Dock="Top" Foreground="#AEB8C3" TextWrapping="Wrap"
                     Margin="2,0,2,10"
                     Text="分類を選んで、作品の追加・並べ替え・削除ができます。新しい作品は一番下に足されます。分類そのものも増やせます。"/>
          <DockPanel DockPanel.Dock="Top" Margin="2,0,10,10">
            <TextBlock Text="分類" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AEB8C3"/>
            <Button DockPanel.Dock="Right" Content="この分類に作品を追加" Click="WorkAddClick" Padding="14,5"/>
            <Button DockPanel.Dock="Right" Content="最近の動画から選ぶ" Click="PickVideosClick" Padding="14,5"
                    ToolTip="YouTubeの新着から、まだ入っていないものを選んで足します。"/>
            <Button DockPanel.Dock="Right" Content="分類を追加" Click="CategoryAddClick" Padding="14,5"/>
            <ComboBox x:Name="CategoryPicker" MinWidth="240" DisplayMemberPath="Display"
                      SelectionChanged="CategoryPickerChanged"/>
          </DockPanel>
          <Border DockPanel.Dock="Top" x:Name="CategoryBox" Background="#1A1F26" BorderBrush="#2F3845"
                  BorderThickness="1" Margin="2,0,10,10" Padding="12,10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0"
                          VerticalAlignment="Top">
                <Button Content="↑" Click="CategoryUpClick" Width="30" Padding="0,3"/>
                <Button Content="↓" Click="CategoryDownClick" Width="30" Padding="0,3"/>
                <Button Content="✕" Click="CategoryDeleteClick" Width="30" Padding="0,3"
                        ToolTip="この分類を、中の作品ごと一覧から外します"/>
              </StackPanel>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="分類の名前" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="合い言葉（英小文字）" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="ページの中で分類を見分けるための名前です。作ったあとは変えないほうが安全です。"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="分類の説明" Style="{StaticResource Caption}" Margin="0,6,0,3"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{Binding Error}"
                           Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="WorkItems" ItemTemplate="{StaticResource WorkTemplate}" Margin="2,0,10,10"/>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="うれしいこと">
        <DockPanel Margin="4,10,4,0">
          <TextBlock DockPanel.Dock="Top" Foreground="#AEB8C3" TextWrapping="Wrap" Margin="2,0,2,10"
                     Text="トップページの「うれしいこと」欄です。受賞やイベント参加のお知らせを、追加・並べ替え・削除できます。新しいお知らせは一番下に足されます。"/>
          <DockPanel DockPanel.Dock="Top" Margin="2,0,10,10">
            <Button DockPanel.Dock="Right" Content="お知らせを追加" Click="NewsAddClick" Padding="14,5"/>
            <TextBlock Foreground="#8C97A6" FontSize="11" VerticalAlignment="Center"
                       Text="見出しに出ている年は「トップページ」タブで直せます。"/>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="NewsItems" ItemTemplate="{StaticResource NewsTemplate}" Margin="2,0,10,10"/>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="ゲーム" x:Name="GameTab">
        <DockPanel Margin="4,10,4,0">
          <TextBlock x:Name="GameNote" DockPanel.Dock="Top" Foreground="#AEB8C3" TextWrapping="Wrap"
                     Margin="2,0,2,10"/>
          <DockPanel DockPanel.Dock="Top" Margin="2,0,10,10">
            <TextBlock Text="編集するもの" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AEB8C3"/>
            <Button DockPanel.Dock="Right" x:Name="GameCardAddButton" Content="カードを追加"
                    Click="GameCardAddClick" Padding="14,5"/>
            <Button DockPanel.Dock="Right" x:Name="WorldArchiveAddButton" Content="新しい箱を作る"
                    Click="WorldArchiveAddClick" Padding="14,5"/>
            <Button DockPanel.Dock="Right" x:Name="ChangelogAddButton" Content="新しい版を追加"
                    Click="ChangelogAddClick" Padding="14,5"
                    ToolTip="更新履歴の一番上に足します。版は前の版から1つ進めます。"/>
            <ComboBox x:Name="GamePicker" MinWidth="260" SelectionChanged="GamePickerChanged"/>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2,0,10,10">

              <!-- ゲーム集（一覧ページ） -->
              <StackPanel x:Name="GameListPanel">
                <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,8"
                        Padding="12,10">
                  <StackPanel>
                    <TextBlock Text="ゲーム集のひとこと" FontSize="14" Margin="0,0,0,6"/>
                    <TextBox x:Name="GameLeadBox"/>
                    <TextBlock x:Name="GameLeadError" Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <ItemsControl x:Name="GameCardItems" ItemTemplate="{StaticResource GameCardTemplate}"/>
              </StackPanel>

              <!-- ゲーム1本ぶんのページ -->
              <StackPanel x:Name="GamePagePanel">
                <ItemsControl x:Name="GameRows" ItemTemplate="{StaticResource RowTemplate}"/>
                <ItemsControl x:Name="GameDescription" ItemTemplate="{StaticResource TextBlockTemplate}"/>

                <Border x:Name="ChangelogSection" Background="#1A1F26" BorderBrush="#2F3845" BorderThickness="1"
                        Margin="0,4,0,0" Padding="12,10">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock DockPanel.Dock="Left" Text="更新履歴" FontSize="15" Foreground="#FFCB75"/>
                      <Button DockPanel.Dock="Right" x:Name="AlignVersionButton" Content="版をそろえる"
                              Click="AlignVersionClick"
                              ToolTip="更新履歴の一番上の版に、このページの表記と一覧の札をそろえます。"/>
                      <TextBlock x:Name="VersionSummary" Margin="14,2,0,0" TextWrapping="Wrap"
                                 Foreground="#E4E8EC"/>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#8C97A6" FontSize="11" Margin="0,0,0,10"
                               Text="新しいものが上です。「新しい版を追加」で一番上に足せます。内容は1行＝1つで、**ここ** と書くと太字になります。"/>
                    <ItemsControl x:Name="ChangelogItems" ItemTemplate="{StaticResource ChangelogTemplate}"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- HALKA WORLD の更新履歴 -->
              <StackPanel x:Name="WorldPanel">
                <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Margin="0,0,0,8"
                        Padding="12,10">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="いまの版" Width="90" VerticalAlignment="Center"
                               FontSize="14"/>
                    <Button DockPanel.Dock="Right" x:Name="WorldAlignButton" Content="版をそろえる"
                            Click="WorldAlignClick"
                            ToolTip="更新履歴の一番上の版に、ページの表記をそろえます。"/>
                    <TextBox x:Name="WorldVersionBox" MaxWidth="180" HorizontalAlignment="Left"
                             MinWidth="140"/>
                  </DockPanel>
                </Border>
                <TextBlock x:Name="WorldSummary" Foreground="#E4E8EC" TextWrapping="Wrap" Margin="2,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="#8C97A6" FontSize="11" Margin="2,0,0,10"
                           Text="新しいものが上です。「新しい版を追加」で、いちばん上の箱の先頭に足します。箱がいっぱいになったら「新しい箱を作る」で分けてください。ゲーム本体の差し替えは、これまでどおり Unity 側の手順です。"/>
                <ItemsControl x:Name="WorldItems" ItemTemplate="{StaticResource WorldArchiveTemplate}"/>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="リンク">
        <DockPanel Margin="4,10,4,0">
          <TextBlock x:Name="LinkNote" DockPanel.Dock="Top" Foreground="#AEB8C3" TextWrapping="Wrap"
                     Margin="2,0,2,10"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2,0,10,10">
              <TextBlock Text="大きいリンク" FontSize="15" Margin="2,0,0,7" Foreground="#FFCB75"/>
              <ItemsControl x:Name="LinkItems" ItemTemplate="{StaticResource RowTemplate}"/>

              <Border x:Name="LinkGridBox" Background="#1A1F26" BorderBrush="#2F3845" BorderThickness="1"
                      Margin="0,8,0,0" Padding="12,10">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="リンク集" FontSize="15" Foreground="#FFCB75"/>
                    <Button DockPanel.Dock="Right" Content="リンクを追加" Click="LinkAddClick" Padding="14,5"/>
                    <TextBlock Foreground="#8C97A6" FontSize="11" Margin="14,3,0,0" TextWrapping="Wrap"
                               Text="並んでいる順に出ます。「大きく出す」は1枚だけにしてください。"/>
                  </DockPanel>
                  <ItemsControl x:Name="LinkCardItems" ItemTemplate="{StaticResource LinkCardTemplate}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="トップページ">
        <DockPanel Margin="4,10,4,0">
          <TextBlock x:Name="TopNote" DockPanel.Dock="Top" Foreground="#AEB8C3"
                     TextWrapping="Wrap" Margin="2,0,2,10"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2,0,10,10">
              <Border Background="#20262F" BorderBrush="#2F3845" BorderThickness="1" Padding="12,10">
                <StackPanel>
                  <TextBlock x:Name="VideoLabel" FontSize="14" Margin="0,0,0,6"/>
                  <TextBox x:Name="VideoBox" TextChanged="VideoBoxChanged" BorderThickness="2"/>
                  <TextBlock x:Name="VideoError" Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap"
                             Margin="0,5,0,0"/>
                  <TextBlock x:Name="VideoIdText" Foreground="#9AA6B4" FontSize="11" Margin="0,5,0,0"/>
                  <Image x:Name="VideoThumb" Width="320" Height="180" Margin="0,10,0,0"
                         HorizontalAlignment="Left" Stretch="Uniform"/>
                </StackPanel>
              </Border>
              <Border x:Name="ProfileBox" Background="#20262F" BorderBrush="#2F3845" BorderThickness="1"
                      Margin="0,10,0,0" Padding="12,10">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="ﾊﾙｶﾁｬﾝ" FontSize="14"/>
                    <Button DockPanel.Dock="Right" Content="画像を選ぶ..." Click="CardChooseClick"
                            Tag="profile" Padding="14,5"/>
                    <Button DockPanel.Dock="Right" x:Name="ProfileClearButton" Content="選び直しをやめる"
                            Click="CardClearClick" Tag="profile"/>
                    <TextBlock x:Name="ProfileSummary" Margin="14,3,0,0" Foreground="#AEB8C3"/>
                  </DockPanel>
                  <TextBlock TextWrapping="Wrap" Foreground="#8C97A6" FontSize="11" Margin="0,0,0,8"
                             Text="トップページでつつけるGIFです。差し替えると、読み込んでいる2か所の番号を自動で上げます（古い絵が残らないように）。"/>
                  <Image x:Name="ProfilePreview" Width="96" Height="96" HorizontalAlignment="Left"
                         Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                  <TextBlock x:Name="ProfileError" Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap"
                             Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <ItemsControl x:Name="TopRows" ItemTemplate="{StaticResource RowTemplate}" Margin="0,10,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="はるかくらぶ" x:Name="ClubTab">
        <DockPanel Margin="4,10,4,0">
          <TextBlock x:Name="ClubNote" DockPanel.Dock="Top" Foreground="#AEB8C3" TextWrapping="Wrap"
                     Margin="2,0,2,10"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2,0,10,10">
              <ItemsControl x:Name="ClubItems" ItemTemplate="{StaticResource RowTemplate}"/>
              <Border x:Name="ClubUpdateBox" Background="#20262F" BorderBrush="#2F3845" BorderThickness="1"
                      Padding="12,10">
                <StackPanel>
                  <DockPanel Margin="0,0,0,5">
                    <TextBlock DockPanel.Dock="Left" Text="更新内容" FontSize="14"/>
                    <TextBlock x:Name="ClubUpdateHint" Foreground="#8C97A6" FontSize="11" Margin="12,2,0,0"/>
                  </DockPanel>
                  <TextBox x:Name="ClubUpdateText" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="70" MaxHeight="200" VerticalScrollBarVisibility="Auto"/>
                  <TextBlock x:Name="ClubUpdateError" Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap"
                             Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="うたまぜ！" x:Name="UtamazeTab">
        <DockPanel Margin="4,10,4,0">
          <TextBlock x:Name="UtamazeNote" DockPanel.Dock="Top" Foreground="#AEB8C3" TextWrapping="Wrap"
                     Margin="2,0,2,10"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2,0,10,10">
              <ItemsControl x:Name="UtamazeItems" ItemTemplate="{StaticResource RowTemplate}"/>

              <Border x:Name="ReleaseSection" Background="#1A1F26" BorderBrush="#2F3845" BorderThickness="1"
                      Margin="0,12,0,0" Padding="12,10">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="リリース手順" FontSize="15" Foreground="#FFCB75"/>
                    <Button DockPanel.Dock="Right" Content="まとめて公開の形にする" Click="ReleaseAllClick"/>
                    <TextBlock x:Name="ReleaseSummary" Margin="14,2,0,0" TextWrapping="Wrap"
                               Foreground="#E4E8EC"/>
                  </DockPanel>

                  <TextBlock TextWrapping="Wrap" Foreground="#8C97A6" FontSize="11" Margin="0,0,0,10"
                             Text="正式リリースのときに必要な場所を全部ならべています。どれか1つだけ変えて気づかない、を防ぐためのものです。準備中へ戻すこともできます。"/>

                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                      <TextBlock Text="ダウンロードのURL" Style="{StaticResource Caption}"/>
                      <TextBox x:Name="ReleaseDownload" Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="PROの購入URL（Lemon Squeezy の共有用）" Style="{StaticResource Caption}"/>
                      <TextBox x:Name="ReleaseCheckout" Text="{Binding CheckoutUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </Grid>

                  <ItemsControl x:Name="ReleaseItems" ItemTemplate="{StaticResource ReleaseTemplate}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="ページの顔" x:Name="MetaTab">
        <DockPanel Margin="4,10,4,0">
          <TextBlock x:Name="MetaNote" DockPanel.Dock="Top" Foreground="#AEB8C3" TextWrapping="Wrap"
                     Margin="2,0,2,10"/>
          <DockPanel DockPanel.Dock="Top" Margin="2,0,10,10">
            <TextBlock Text="ページ" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AEB8C3"/>
            <Button DockPanel.Dock="Right" Content="sitemap を作り直す" Click="SitemapClick" Padding="14,5"
                    ToolTip="いまサイトにあるページから sitemap.xml と robots.txt を作り直します。"/>
            <Button DockPanel.Dock="Right" x:Name="CardImagesButton" Content="カード画像を作り直す"
                    Click="CardImagesClick" Padding="14,5"
                    ToolTip="tools/ogp/generate-ogp.py を動かして、8枚のカード画像を作り直します。"/>
            <ComboBox x:Name="MetaPagePicker" MinWidth="240" SelectionChanged="MetaPageChanged"/>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2,0,10,10">
              <ItemsControl x:Name="MetaRows" ItemTemplate="{StaticResource RowTemplate}"/>

              <Border x:Name="CardBox" Background="#1A1F26" BorderBrush="#2F3845" BorderThickness="1"
                      Margin="0,4,0,0" Padding="12,10">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="カード画像" FontSize="15" Foreground="#FFCB75"/>
                    <Button DockPanel.Dock="Right" Content="画像を選ぶ..." Click="CardChooseClick"
                            Tag="card" Padding="14,5"/>
                    <Button DockPanel.Dock="Right" x:Name="CardClearButton" Content="選び直しをやめる"
                            Click="CardClearClick" Tag="card"/>
                    <TextBlock x:Name="CardSummary" Margin="14,3,0,0" Foreground="#E4E8EC"/>
                  </DockPanel>
                  <TextBlock TextWrapping="Wrap" Foreground="#8C97A6" FontSize="11" Margin="0,0,0,8"
                             Text="XやDiscordにURLを貼ると、この絵が出ます。1200×630 のPNGです。絵柄と中の文字は tools/ogp/generate-ogp.py で決まっていて、上の文章とは別です。"/>
                  <Image x:Name="CardPreview" MaxHeight="210" HorizontalAlignment="Left" Stretch="Uniform"/>
                  <TextBlock x:Name="CardError" Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap"
                             Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="見出しと飾り" x:Name="DecorTab">
        <DockPanel Margin="4,10,4,0">
          <TextBlock x:Name="DecorNote" DockPanel.Dock="Top" Foreground="#AEB8C3" TextWrapping="Wrap"
                     Margin="2,0,2,10"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DecorItems" ItemTemplate="{StaticResource RowTemplate}" Margin="2,0,10,10"/>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="サイトの基本色">
        <DockPanel Margin="4,10,4,0">
          <TextBlock x:Name="ColorNote" DockPanel.Dock="Top" Foreground="#AEB8C3"
                     TextWrapping="Wrap" Margin="2,0,2,10"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ColorItems" ItemTemplate="{StaticResource ColorTemplate}" Margin="2,0,10,10"/>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

    </TabControl>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#2F3845"
                    x:Name="PreviewSplitter"/>

      <!-- 右：プレビュー -->
      <Border Grid.Column="2" x:Name="PreviewPanel" Background="#1A1F26" BorderBrush="#2F3845"
              BorderThickness="1,0,0,0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <TextBlock Text="ページ" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="#AEB8C3"/>
            <Button DockPanel.Dock="Right" Content="更新" Click="RefreshPreviewClick" Padding="14,5"/>
            <ComboBox x:Name="PagePicker" MinWidth="180" Margin="0,0,8,0"
                      SelectionChanged="PagePickerChanged"/>
          </DockPanel>

          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,6">
            <TextBlock Text="表示" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AEB8C3"/>
            <RadioButton x:Name="ShowBoth" Content="両方" IsChecked="True" GroupName="PreviewMode"
                         Foreground="#DDE2E8" Margin="0,0,14,0" Checked="PreviewModeChanged"/>
            <RadioButton x:Name="ShowDesktop" Content="PCのみ" GroupName="PreviewMode"
                         Foreground="#DDE2E8" Margin="0,0,14,0" Checked="PreviewModeChanged"/>
            <RadioButton x:Name="ShowMobile" Content="スマホのみ" GroupName="PreviewMode"
                         Foreground="#DDE2E8" Checked="PreviewModeChanged"/>
          </StackPanel>

          <TextBlock x:Name="PreviewNote" DockPanel.Dock="Bottom" Margin="9,4,9,8" TextWrapping="Wrap"
                     Foreground="#8C97A6" FontSize="11"
                     Text="「保存する」を押すと、この表示も作り直されます。"/>

          <Grid x:Name="PreviewArea">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="0"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="DesktopBox" Grid.Column="0" Margin="8,0,4,0">
              <TextBlock DockPanel.Dock="Top" x:Name="DesktopCaption" Text="PC"
                         Foreground="#9AA6B4" FontSize="11" Margin="1,0,0,4"/>
              <Border Background="#E9E8DF" ClipToBounds="True">
                <wv2:WebView2 x:Name="DesktopView" SizeChanged="DesktopViewSizeChanged"/>
              </Border>
            </DockPanel>

            <DockPanel x:Name="MobileBox" Grid.Column="1" Margin="4,0,8,0">
              <TextBlock DockPanel.Dock="Top" Text="スマホ（375px）"
                         Foreground="#9AA6B4" FontSize="11" Margin="1,0,0,4"/>
              <Border Width="375" Background="#E9E8DF" ClipToBounds="True">
                <wv2:WebView2 x:Name="MobileView"/>
              </Border>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
