<Window x:Class="HalkaSiteEditor.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公開する前の点検" Width="900" Height="600" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#16191E" Foreground="#E4E8EC" FontFamily="Yu Gothic UI" FontSize="13">

  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#333B46"/>
      <Setter Property="Foreground" Value="#F1F3F6"/>
      <Setter Property="BorderBrush" Value="#586170"/>
      <Setter Property="Padding" Value="18,7"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" FontSize="15" TextWrapping="Wrap"
               Margin="0,0,0,6"/>
    <TextBlock DockPanel.Dock="Top" Foreground="#8C97A6" FontSize="11" TextWrapping="Wrap"
               Margin="0,0,0,12"
               Text="「問題」は直したほうがよいもの、「気になる」は知らせておきたいものです。ここでは何も書き換えません。"/>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="閉じる" Click="CloseClick" IsDefault="True" IsCancel="True"/>
      <Button DockPanel.Dock="Right" Content="もう一度点検する" x:Name="AgainButton" Click="AgainClick"/>
      <TextBlock/>
    </DockPanel>

    <ListView x:Name="IssueList" Background="#242A33" Foreground="#EDF0F3" BorderBrush="#2F3845">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="" Width="80" DisplayMemberBinding="{Binding LevelText}"/>
          <GridViewColumn Header="見つけたこと" Width="230" DisplayMemberBinding="{Binding What}"/>
          <GridViewColumn Header="内容" Width="360" DisplayMemberBinding="{Binding Detail}"/>
          <GridViewColumn Header="ファイル" Width="190" DisplayMemberBinding="{Binding File}"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
