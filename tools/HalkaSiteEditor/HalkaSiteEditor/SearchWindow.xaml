<Window x:Class="HalkaSiteEditor.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="直せるところを探す" Width="920" Height="580" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#16191E" Foreground="#E4E8EC" FontFamily="Yu Gothic UI" FontSize="13">

  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#333B46"/>
      <Setter Property="Foreground" Value="#F1F3F6"/>
      <Setter Property="BorderBrush" Value="#586170"/>
      <Setter Property="Padding" Value="18,7"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#242A33"/>
      <Setter Property="Foreground" Value="#F1F3F6"/>
      <Setter Property="BorderBrush" Value="#586170"/>
      <Setter Property="CaretBrush" Value="#F1F3F6"/>
      <Setter Property="Padding" Value="6,6"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="探す文字" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBox x:Name="QueryBox" TextChanged="QueryChanged"/>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" Foreground="#AEB8C3" FontSize="11"
               TextWrapping="Wrap" Margin="0,0,0,10"
               Text="直せるところを、タブをまたいで探します。選んで「ここへ移る」を押すと、そのタブへ移ります。"/>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="閉じる" Click="CloseClick" IsCancel="True"/>
      <Button DockPanel.Dock="Right" x:Name="GoButton" Content="ここへ移る" Click="GoClick"
              IsDefault="True" IsEnabled="False"/>
      <TextBlock/>
    </DockPanel>

    <ListView x:Name="HitList" Background="#242A33" Foreground="#EDF0F3" BorderBrush="#2F3845"
              SelectionChanged="HitSelected" MouseDoubleClick="GoClick">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="タブ" Width="130" DisplayMemberBinding="{Binding Tab}"/>
          <GridViewColumn Header="どこ" Width="320" DisplayMemberBinding="{Binding Where}"/>
          <GridViewColumn Header="見つかった文字" Width="400" DisplayMemberBinding="{Binding Excerpt}"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
